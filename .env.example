# End-to-end test configuration. Copy to .env.local and fill in; .env.local is git-ignored.

# --- LLM: tests/e2e/llm.spec.ts calls the real API; skipped while empty ---
# openai | anthropic | google | openrouter | deepseek | custom
E2E_LLM_PROVIDER=
E2E_LLM_API_KEY=
# Model id from the provider's catalog, e.g. gpt-5-mini, claude-haiku-4-5, deepseek-flash
E2E_LLM_MODEL=
# Only for E2E_LLM_PROVIDER=custom, e.g. https://api.example.com/v1.
# Tests skip the host-permission prompt, so the endpoint must allow CORS.
E2E_LLM_BASE_URL=

# --- ASR: tests/e2e/asr.spec.ts transcribes a real video's audio; skipped while empty ---
# bcut (free, no key) | openai | groq | siliconflow | dashscope | custom
E2E_ASR_PROVIDER=
E2E_ASR_API_KEY=
# Optional; defaults per provider (whisper-1, whisper-large-v3-turbo,
# FunAudioLLM/SenseVoiceSmall, fun-asr-flash-2026-06-15)
E2E_ASR_MODEL=
# Only for E2E_ASR_PROVIDER=custom, e.g. https://api.example.com/v1 (must allow CORS)
E2E_ASR_BASE_URL=
# Only for dashscope (Alibaba Cloud Model Studio / 百炼):
# cn-beijing | ap-southeast-1
E2E_ASR_DASHSCOPE_REGION=
# Workspace ID for the {WorkspaceId}.{region}.maas.aliyuncs.com endpoint;
# leave empty to use the shared dashscope(-intl).aliyuncs.com endpoint
E2E_ASR_DASHSCOPE_WORKSPACE=

# --- Bilibili (optional) ---
# Without these, tests use a built-in transcript. With your SESSDATA cookie and a video
# that has subtitles, the real-LLM tests run against that video's real subtitles.
E2E_BILIBILI_SESSDATA=
E2E_BILIBILI_BVID=
