# End-to-end test configuration. Copy to .env.local and fill in; .env.local is git-ignored.

# --- LLM: tests/e2e/llm.spec.ts calls the real API; skipped while empty ---
# openai | anthropic | google | openrouter | deepseek | custom
E2E_LLM_PROVIDER=
E2E_LLM_API_KEY=
# Model id from the provider's catalog, e.g. gpt-5-mini, claude-haiku-4-5, deepseek-flash
E2E_LLM_MODEL=
# Only for E2E_LLM_PROVIDER=custom, e.g. https://api.example.com/v1.
# Tests skip the host-permission prompt, so the endpoint must allow CORS.
E2E_LLM_BASE_URL=

# --- ASR: not used by any test yet ---
E2E_ASR_BASE_URL=
E2E_ASR_API_KEY=
E2E_ASR_MODEL=

# --- Bilibili (optional) ---
# Without these, tests use a built-in transcript. With your SESSDATA cookie and a video
# that has subtitles, the real-LLM tests run against that video's real subtitles.
E2E_BILIBILI_SESSDATA=
E2E_BILIBILI_BVID=
